# OpenGravity MCP Server — Template de Configuración
# ===================================================
# Copia este archivo como .env y reemplaza con tus claves reales.
#
#   cp .env.example .env
#
# NUNCA subas tu .env real a un repositorio público.

# Groq API Key (Inferencia ultra-rápida con modelos open-source)
# Consigue tu clave en: https://console.groq.com
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenRouter API Key (Acceso unificado a cientos de modelos)
# Consigue tu clave en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# GitHub Personal Access Token (PAT)
# Consigue tu token en: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

